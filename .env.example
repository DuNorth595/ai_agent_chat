# ai_agent_chat — environment configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Only BRAIN_API_KEY is truly required. Everything else has a working
# default. The values below are placeholders — never commit a real key.

# ─── Brain (LLM) ──────────────────────────────────────────────────────────
# Required. The brain speaks the Anthropic Messages API, so any
# Anthropic-compatible endpoint works.
BRAIN_API_KEY=REPLACE_ME
BRAIN_MODEL=MINIMAX-M3
# BRAIN_API_URL=https://api.anthropic.com/v1/messages

# Hard cap on the reply. Replies that hit the cap are truncated rather
# than continued. Raise it for long-form answers; expect slower TTS.
BRAIN_MAX_TOKENS=2000

# ─── Barge-in / duplex ───────────────────────────────────────────────────
# Set to 1 to enable real full-duplex conversation: persistent mic and
# interrupting the agent mid-sentence. Off by default.
AVA_BARGE_IN=0

# How long to keep collecting an interrupted utterance, in ms.
AVA_BARGE_CAPTURE_MAX_MS=8000

# Silence (in 30 ms blocks) that ends an utterance. 12 blocks = 360 ms.
AVA_BARGE_ENDPOINT_BLOCKS=12

# Set to 1 to log mic RMS levels every 10 frames. Useful for tuning the
# detector in a noisy room. Noisy — keep it off in production.
AVA_BARGE_TRACE=0

# ─── Telegram (optional) ──────────────────────────────────────────────────
# Without these, the bridge still runs; the send_message tool and the
# home-channel sync are no-ops.
# TELEGRAM_BOT_TOKEN=REPLACE_ME
# TELEGRAM_HOME_CHANNEL=REPLACE_ME

# ─── Bridge network ──────────────────────────────────────────────────────
# Bind address. 0.0.0.0 = reachable from any interface (LAN, VPN, etc.).
# Use 127.0.0.1 to lock down to local-only.
AVA_HOST=0.0.0.0
AVA_PORT=8770

# CORS origins — comma-separated. "*" is fine for a single-user local
# install. Tighten it if the bridge is reachable from a shared network.
AVA_CORS_ORIGINS=*

# ─── TLS ──────────────────────────────────────────────────────────────────
# Browsers require HTTPS for microphone access (iOS Safari especially).
# If certs exist under certs/ and these are unset, the bridge uses them.
AVA_TLS_CERT=certs/server.crt
AVA_TLS_KEY=certs/server.key
# AVA_HTTPS=0   # uncomment to force plain HTTP (localhost only)

# ─── TTS provider selection ───────────────────────────────────────────────
# 'piper' (default — requires the piper CLI and an ONNX voice model)
# 'kokoro' (requires the kokoro Python package; slower, sounds better)
AVA_TTS_PROVIDER=piper

# Piper CLI binary and voice model. Defaults shown; override if installed
# elsewhere. PIPER_MODEL is the filename WITHOUT the .onnx extension.
PIPER_BIN=piper
PIPER_MODEL_DIR=~/.local/share/piper/voices
PIPER_MODEL=en_US-libritts_r-medium
# PIPER_SAMPLE_RATE=22050

# Kokoro server and voice.
# KOKORO_URL=http://127.0.0.1:8080
# KOKORO_VOICE=af_heart

# ─── STT (whisper.cpp) ────────────────────────────────────────────────────
# The whisper.cpp HTTP server endpoint. Must be running.
WHISPER_URL=http://127.0.0.1:8178/inference
# WHISPER_TIMEOUT=30

# ─── Memory layer (optional; see memory.py) ───────────────────────────────
# These are read from disk and included in the system prompt. Point them
# at your own files. If you leave them unset, the memory layer is off.
# MEMORY_IDENTITY_FILE=identity.md
# MEMORY_SOUL_PATH=~/.config/ai_agent_chat/SOUL.md
# MEMORY_INDEX_PATH=~/.config/ai_agent_chat/MEMORY_INDEX.md
# MEMORY_LIFE_DIR=~/.local/share/ai_agent_chat/life
# MEMORY_FACT_STORE_DB=~/.local/share/ai_agent_chat/facts.db
# MEMORY_SESSIONS_DIR=~/.local/share/ai_agent_chat/sessions

# ─── Skills loader (optional; see skills_bridge.py) ───────────────────────
# AVA_SKILLS_ROOT=/path/to/skills
# AVA_ALWAYS_LOAD_SKILLS=skill-one,skill-two
# AVA_TRIGGER_KEYWORDS_JSON={"my-keyword":["my-skill"]}

# ─── Debug ────────────────────────────────────────────────────────────────
# Set to 1 to enable DEBUG-level logging.
AVA_VERBOSE=0

# ─── Tests ────────────────────────────────────────────────────────────────
# Where the test suite looks for the Piper binary and a voice model.
# If unset it searches the repo venvs, PATH, and common install locations.
# AVA_TEST_PIPER=/path/to/piper
# AVA_TEST_PIPER_MODEL=/path/to/voice.onnx
